alias link_setup="\
  sudo ip link set enx9cebe8ed31d2 up &&
  nmcli device set enx9cebe8ed31d2 managed no &&
  sudo ip link set enx9cebe8ed31d2 multicast off &&
  sudo sysctl -w net.ipv6.conf.enx9cebe8ed31d2.disable_ipv6=1 &&
  sudo sysctl -w net.ipv4.conf.enx9cebe8ed31d2.arp_ignore=0 &&
  sudo sysctl -w net.ipv4.conf.enx9cebe8ed31d2.arp_announce=2 
"

